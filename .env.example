# Gemini (Google AI Studio key). LLM_BASE_URL stays empty unless you use a proxy
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Optional (F5): extra models for the model menu, comma-separated
LLM_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Decision model: free key from https://decision.vllm-sr.ai (one click, no account)
DECISION_API_KEY=
DM_MODEL=vllm-sr/d3-turbo
# dm+llm: below this confidence the LLM takes over
DM_CONFIDENCE_THRESHOLD=0.7

# Smoke test: tickets processed in parallel (keep low on free tiers)
SMOKE_CONCURRENCY=2
